# Copiá este archivo como .env.local y completá tus claves (.env.local no se sube al repo).

# Claude (https://console.anthropic.com): entender lo que contás, recomendaciones.
ANTHROPIC_API_KEY=

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys): la voz de "Armala hablando".
# Solo se usa en el servidor (/api/tts). Sin clave, la app usa la voz del navegador.
ELEVENLABS_API_KEY=

# Supabase (https://supabase.com/dashboard → tu proyecto → Project Settings → API).
# Son datos públicos (la anon key se puede ver en el navegador); la service_role NO va acá ni en ningún lado del repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
